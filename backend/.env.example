# Copy into backend/.env after TASK-04 creates the backend package.
# NEVER COMMIT actual .env or credentials.
MUSEDESK_ENV=development
MUSEDESK_HOST=127.0.0.1
MUSEDESK_PORT=8765
MUSEDESK_DB_PATH=./data/musedesk.sqlite3
MUSEDESK_WORKSPACE_ROOT=./sandbox_workspaces
MUSEDESK_TASK_TIMEOUT_SECONDS=90
MUSEDESK_REQUIRE_PAIRING=true
MUSEDESK_LOG_LEVEL=INFO
# Optional: choose and provision private LLM/STT provider via backend only.
# MUSEDESK_MODEL_PROVIDER=...
# MUSEDESK_PROVIDER_API_KEY=...

# ── Wall Habitat (Phase 3) with Claude. Install: pip install -e .[model]
# The model is used only when the producer is live (demo mode stays scripted and labelled).
# MUSEDESK_PRODUCER=live
# MUSEDESK_MODEL_PROVIDER=anthropic
# MUSEDESK_PROVIDER_API_KEY=sk-ant-...        (or set ANTHROPIC_API_KEY instead)
# MUSEDESK_P3_MODEL=claude-opus-5-5
# MUSEDESK_P3_SIDE_EFFORT=low                 (low | medium | high | xhigh | max)
# MUSEDESK_P3_PLAN_EFFORT=medium
# MUSEDESK_P3_WORK_EFFORT=medium
# MUSEDESK_P3_SIDE_CONVERSATION_ENABLED=true
# MUSEDESK_P3_MANAGER_ENABLED=true
# MUSEDESK_P3_PLAN_RUNNER_ENABLED=true        (works the cards an approved Manager plan created)
