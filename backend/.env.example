# Copy into backend/.env after TASK-04 creates the backend package.
# NEVER COMMIT actual .env or credentials.
MUSEDESK_ENV=development
MUSEDESK_HOST=127.0.0.1
MUSEDESK_PORT=8765
MUSEDESK_DB_PATH=./data/musedesk.sqlite3
MUSEDESK_WORKSPACE_ROOT=./sandbox_workspaces
MUSEDESK_TASK_TIMEOUT_SECONDS=90
MUSEDESK_REQUIRE_PAIRING=true
MUSEDESK_LOG_LEVEL=INFO
# Optional: choose and provision private LLM/STT provider via backend only.
# MUSEDESK_MODEL_PROVIDER=...
# MUSEDESK_PROVIDER_API_KEY=...
