{
  "title": "Phase 2 inspectable artifact",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "task_id",
    "kind",
    "summary",
    "source_mode",
    "content_hash",
    "created_at",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "code_diff",
        "test_report",
        "research_report",
        "implementation_plan",
        "completion"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "source_mode": {
      "enum": [
        "live",
        "demo"
      ]
    },
    "content_hash": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "page",
          "title",
          "content"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "content": {
            "type": "string",
            "maxLength": 12000
          },
          "line_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 500
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musedesk.local/contracts/phase2/artifact_v2.schema.json"
}
