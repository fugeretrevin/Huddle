{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musedesk.local/contracts/event.schema.json",
  "title": "MuseDesk EventEnvelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "seq",
    "session_id",
    "occurred_at",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": [
        "session.ready",
        "agent.status_changed",
        "task.created",
        "task.started",
        "task.progress",
        "decision.requested",
        "decision.resolved",
        "artifact.created",
        "task.completed",
        "task.failed",
        "session.reset",
        "system.warning"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "researcher",
        "developer",
        "tester",
        "system"
      ]
    },
    "decision_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
