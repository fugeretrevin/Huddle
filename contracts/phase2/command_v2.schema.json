{
  "title": "Phase 2 task assignment command",
  "type": "object",
  "required": [
    "schema_version",
    "target_agent_id",
    "expected_revision",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "target_agent_id": {
      "enum": [
        "researcher",
        "developer",
        "tester"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musedesk.local/contracts/phase2/command_v2.schema.json"
}
