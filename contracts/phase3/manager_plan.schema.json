{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musedesk.local/contracts/phase3/manager_plan.schema.json",
  "title": "MuseDesk Phase 3 ManagerPlan",
  "type": "object",
  "required": ["plan_id","source_request_id","title","objective","created_at","provenance","provenance_note","assumptions","risks","items","status","revision","committed_tasks"],
  "properties": {
    "plan_id": {"type":"string"},
    "source_request_id": {"type":"string"},
    "title": {"type":"string","maxLength":120},
    "objective": {"type":"string"},
    "created_at": {"type":"string"},
    "provenance": {"enum":["LIVE_MODEL","TEMPLATE_PLAN","SCRIPTED_DEMO"]},
    "provenance_note": {"type":"string"},
    "assumptions": {"type":"array","items":{"type":"string"}},
    "risks": {"type":"array","items":{"type":"string"}},
    "items": {"type":"array","minItems":1,"maxItems":12,"items": {"type":"object","additionalProperties":false,"required":["client_item_id","title","kind","proposed_agent","depends_on","acceptance_criteria","required_permission","dangerous","danger_reasons"],"properties":{"client_item_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,40}$"},"title":{"type":"string","minLength":1,"maxLength":120},"kind":{"enum":["research","code","implement","test","verify","doc"]},"proposed_agent":{"enum":["researcher","developer","tester"]},"depends_on":{"type":"array","items":{"type":"string"}},"acceptance_criteria":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":200}},"required_permission":{"enum":["none","read_repo","workspace_write","run_tests"]},"dangerous":{"type":"boolean"},"danger_reasons":{"type":"array","items":{"type":"string"}}}} },
    "status": {"enum":["proposed","approved","rejected","committed","failed"]},
    "revision": {"type":"integer","minimum":1},
    "reject_reason": {"type":["string","null"]},
    "failure": {"type":["object","null"]},
    "committed_tasks": {"type":"array","items": {"type":"object","additionalProperties":false,"required":["client_item_id","task_id","agent_id","state","revision"],"properties":{"client_item_id":{"type":"string"},"task_id":{"type":"string"},"agent_id":{"type":"string"},"state":{"type":"string"},"revision":{"type":"integer","minimum":0}}} }
  }
}
